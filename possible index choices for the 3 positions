import java.util.ArrayList;

public class Main {
    public static void main(String[] args) {
        ArrayList<Integer> x = new ArrayList<>();
        x.add(1); x.add(2); x.add(3);

        // Loop through all possible index choices for the 3 positions
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                for (int k = 0; k < 3; k++) {
                    
                    // Make sure we don't pick the same index twice
                    if (i != j && j != k && i != k) {
                        System.out.println(x.get(i) + "," + x.get(j) + "," + x.get(k) + ",");
                    }
                    
                }
            }
        }
    }
}
