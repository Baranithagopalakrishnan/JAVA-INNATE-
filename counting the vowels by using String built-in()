import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a string :");
        String str = sc.nextLine();
        int count = 0;
        
        // FIX 1: Turn the characters into a built-in master String for lookups
        String vowels = "aioueAEIOU"; 

        for (int i = 0; i < str.length(); i++) {
            char chi = str.charAt(i);
            
            // FIX 2: Check if the master string contains our single character
            if (vowels.contains("" + chi)) {
                count++;
            }
        }
        System.out.print(count); // Prints the final total after the loop ends
        sc.close();
    }
}
